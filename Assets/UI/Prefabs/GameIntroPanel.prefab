  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Un Paso a Ciegas es una experiencia de realidad virtual que invita a comprender los retos de la movilidad con discapacidad visual.\n\n<b>Proposito</b>\nAcercar la perspectiva de quienes se desplazan sin vision plena y fomentar empatia sobre la accesibilidad urbana.\n\n<b>Como jugar</b>\n- Muévete por entornos urbanos usando el baston y las pistas sonoras.\n- Completa las tareas de la lista de objetivos.\n- Evita colisiones con obstaculos y zonas de peligro.\n- Llega al area objetivo para completar la experiencia.\n\n<b>Consejos</b>\n- En Ajustes puedes cambiar el modo visual (normal, borroso o ciego).\n- Usa el sonido espacial como guia principal."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
